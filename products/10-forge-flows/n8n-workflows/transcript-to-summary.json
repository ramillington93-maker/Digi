{
  "name": "ForgeFlows - Transcript to Summary",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "/REPLACE/WITH/WATCHED_FOLDER/inbox",
        "options": {}
      },
      "id": "c3d4e5f6-0002-4000-8000-000000000001",
      "name": "Watch Transcript Folder",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json[\"path\"] }}",
        "options": {}
      },
      "id": "c3d4e5f6-0002-4000-8000-000000000002",
      "name": "Read Transcript File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "command": "=python3 /REPLACE/WITH/PATH/summarize.py \"{{ $json[\"path\"] }}\""
      },
      "id": "c3d4e5f6-0002-4000-8000-000000000003",
      "name": "Run Summarize Script (stub)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "summary_markdown",
              "value": "=# Summary\n\n{{ $json[\"stdout\"] }}\n\n_Generated {{ $now.toISO() }} from {{ $binary.data.fileName }}_"
            },
            {
              "name": "output_filename",
              "value": "=summary-{{ $now.format('yyyy-LL-dd-HHmmss') }}.md"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0002-4000-8000-000000000004",
      "name": "Format Summary Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "fileName": "=/REPLACE/WITH/OUTPUT_FOLDER/{{ $json[\"output_filename\"] }}",
        "dataPropertyName": "summary_markdown",
        "options": {}
      },
      "id": "c3d4e5f6-0002-4000-8000-000000000005",
      "name": "Write Summary Markdown File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Watch Transcript Folder": {
      "main": [
        [
          {
            "node": "Read Transcript File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Transcript File": {
      "main": [
        [
          {
            "node": "Run Summarize Script (stub)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Summarize Script (stub)": {
      "main": [
        [
          {
            "node": "Format Summary Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Summary Output": {
      "main": [
        [
          {
            "node": "Write Summary Markdown File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "d4e5f6a7-0002-4000-8000-000000000001",
  "id": "10002",
  "tags": [
    {
      "name": "ForgeFlows"
    }
  ]
}
