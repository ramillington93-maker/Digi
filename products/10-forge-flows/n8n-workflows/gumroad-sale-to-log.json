{
  "name": "ForgeFlows - Gumroad Sale to Log",
  "nodes": [
    {
      "parameters": {
        "path": "gumroad-sale",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Gumroad Sale Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "REPLACE_WITH_WEBHOOK_ID"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "sale_date",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "product_name",
              "value": "={{ $json[\"body\"][\"product_name\"] }}"
            },
            {
              "name": "buyer_email",
              "value": "={{ $json[\"body\"][\"email\"] }}"
            },
            {
              "name": "sale_price",
              "value": "={{ $json[\"body\"][\"price\"] }}"
            },
            {
              "name": "order_id",
              "value": "={{ $json[\"body\"][\"sale_id\"] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Format Sale Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "REPLACE_WITH_GOOGLE_SHEET_ID",
        "range": "Sales!A:E",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Append Sale Row (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "channel": "#sales",
        "text": "=New sale: {{ $json[\"product_name\"] }} - ${{ $json[\"sale_price\"] }} from {{ $json[\"buyer_email\"] }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Notify Slack Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Gumroad Sale Webhook": {
      "main": [
        [
          {
            "node": "Format Sale Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Sale Row": {
      "main": [
        [
          {
            "node": "Append Sale Row (Google Sheets)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Sale Row (Google Sheets)": {
      "main": [
        [
          {
            "node": "Notify Slack Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "b2c3d4e5-0001-4000-8000-000000000001",
  "id": "10001",
  "tags": [
    {
      "name": "ForgeFlows"
    }
  ]
}
