{
  "name": "ForgeFlows - Daily Task Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "a7b8c9d0-0004-4000-8000-000000000001",
      "name": "Every Day at 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.notion.com/v1/databases/REPLACE_WITH_DATABASE_ID/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "options": {}
      },
      "id": "a7b8c9d0-0004-4000-8000-000000000002",
      "name": "Fetch Tasks (Notion/Airtable stub)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "digest_date",
              "value": "={{ $now.format('yyyy-LL-dd') }}"
            },
            {
              "name": "digest_text",
              "value": "=Daily Task Digest - {{ $now.format('yyyy-LL-dd') }}\n\n{{ $json[\"results\"].map(t => \"- \" + t.properties.Name.title[0].plain_text).join(\"\\n\") }}"
            },
            {
              "name": "task_count",
              "value": "={{ $json[\"results\"].length }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a7b8c9d0-0004-4000-8000-000000000003",
      "name": "Build Digest Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#daily-digest",
        "text": "={{ $json[\"digest_text\"] }}",
        "otherOptions": {}
      },
      "id": "a7b8c9d0-0004-4000-8000-000000000004",
      "name": "Send Digest to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        900,
        220
      ],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "digest@REPLACE-YOUR-DOMAIN.com",
        "toEmail": "REPLACE_WITH_YOUR_EMAIL@example.com",
        "subject": "=Daily Task Digest - {{ $json[\"digest_date\"] }}",
        "text": "={{ $json[\"digest_text\"] }}",
        "options": {}
      },
      "id": "a7b8c9d0-0004-4000-8000-000000000005",
      "name": "Email Digest (stub)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        900,
        380
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Every Day at 7am": {
      "main": [
        [
          {
            "node": "Fetch Tasks (Notion/Airtable stub)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Tasks (Notion/Airtable stub)": {
      "main": [
        [
          {
            "node": "Build Digest Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest Text": {
      "main": [
        [
          {
            "node": "Send Digest to Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Digest (stub)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "b8c9d0e1-0004-4000-8000-000000000001",
  "id": "10004",
  "tags": [
    {
      "name": "ForgeFlows"
    }
  ]
}
