# ForgeNotes — optional LLM enhancement
#
# ForgeNotes works fully with NO key set (rule-based mode). These are
# only read if you want the LLM pass to sharpen the summary, decisions,
# and email draft. Set at most one — Anthropic is tried first.
#
# Requires the matching SDK: pip install anthropic   OR   pip install openai
# (not installed by default — see requirements.txt)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
